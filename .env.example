# SMTP Configuration (preferred names)
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM_NAME=Nova Brief

# Legacy aliases kept for backward compatibility
EMAIL_USER=your_gmail@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Production transactional email (recommended; Gmail remains the fallback)
RESEND_API_KEY=re_your_sending_only_api_key
RESEND_FROM_EMAIL=Nova Brief <updates@novabrief.tech>
RESEND_REPLY_TO=your_gmail@gmail.com

# AI Morning Brief Configuration
NEWSAPI_KEY=your_newsapi_key_here
RECIPIENT_EMAIL=your_default_recipient@example.com

# To generate a Gmail App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Sign in to your Google account
# 3. Select "Mail" and your device
# 4. Click "Generate"
# 5. Copy the 16-character password and paste it above

# To get a NewsAPI Key:
# 1. Go to https://newsapi.org/
# 2. Click "Get API Key"
# 3. Sign up for a free account
# 4. Copy your API key and paste it above

# Flask / App Security
FLASK_ENV=production
SECRET_KEY=your-secret-key

# Admin Dashboard Credentials
ADMIN_EMAIL=admin@novabrief.local
ADMIN_PASSWORD=change-me-now

# Optional NovaBrief Social Studio paths (Nova OS auto-detects the default install and release folders)
# SOCIAL_STUDIO_EXE=C:\path\to\NovaBrief Social Studio.exe
# SOCIAL_STUDIO_INSTALLER=C:\path\to\NovaBrief-Social-Studio-Setup-1.1.1.exe

# SEO Studio target (scheduled monitoring runs through the deployment cron service)
SEO_SITE_URL=https://www.novabrief.tech
ENABLE_IN_PROCESS_SCHEDULER=false

# Google AdSense Management API (read-only OAuth connection)
GOOGLE_ADSENSE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_ADSENSE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_ADSENSE_REDIRECT_URI=https://www.novabrief.tech/analytics/adsense/callback
# Optional dedicated encryption secret; when omitted, Nova OS uses SECRET_KEY.
ADSENSE_TOKEN_ENCRYPTION_KEY=use-a-stable-random-secret-of-at-least-32-characters

