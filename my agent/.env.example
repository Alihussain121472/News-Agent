# Gmail Configuration
EMAIL_USER=your_gmail@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# AI Morning Brief Configuration
NEWSAPI_KEY=your_newsapi_key_here
RECIPIENT_EMAIL=your_default_recipient@example.com

# To generate a Gmail App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Sign in to your Google account
# 3. Select "Mail" and your device
# 4. Click "Generate"
# 5. Copy the 16-character password and paste it above

# To get a NewsAPI Key:
# 1. Go to https://newsapi.org/
# 2. Click "Get API Key"
# 3. Sign up for a free account
# 4. Copy your API key and paste it above

# Flask / App Security
FLASK_ENV=production
SECRET_KEY=your-secret-key

# Admin Dashboard Credentials
ADMIN_EMAIL=admin@novabrief.local
ADMIN_PASSWORD=change-me-now

